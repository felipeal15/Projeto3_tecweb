# Copie este arquivo para backend/.env e preencha. O .env NÃO vai para o Git.

# Qualquer texto longo e aleatório. No deploy, use um diferente deste.
SECRET_KEY=troque-por-um-texto-aleatorio

# True só na máquina local. No Render: False.
DEBUG=True

# Hosts aceitos, separados por vírgula. No Render, adicione o domínio .onrender.com (sem https://).
ALLOWED_HOSTS=localhost,127.0.0.1

# Endereços do frontend que podem chamar a API, separados por vírgula (com http/https, sem barra no final).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Vazio = SQLite local (db.sqlite3). No Render: a External Database URL do PostgreSQL.
DATABASE_URL=

# Chave do Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Opcional. Modelo do Gemini (padrão: gemini-2.5-flash).
GEMINI_MODEL=
